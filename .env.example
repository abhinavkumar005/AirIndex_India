# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Services (placeholders; services are not implemented in Phase 0)
DATABASE_URL=postgresql+psycopg://airindex:change-me@localhost:5432/airindex
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Security placeholders
ADMIN_AUTH_ENABLED=false
SECRET_KEY=replace-with-a-secret-outside-version-control

# Collection safety
ENABLE_REAL_SOURCE_COLLECTION=false
DEFAULT_SOURCE_RATE_LIMIT_PER_MINUTE=10
